# MOBIUS Environment Configuration
# Copy to .env and fill in your values

# Security (REQUIRED in production)
JWT_SECRET_KEY=change-me-to-a-random-256-bit-secret

# Database
DATABASE_URL=postgresql+asyncpg://mobius:mobius@localhost:5432/mobius
REDIS_URL=redis://localhost:6379/0

# AI Providers (at least one required for full functionality)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Local LLM (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# CORS (add your LAN IP for phone access, e.g. http://192.168.1.42:3000)
CORS_ORIGINS=http://localhost:3000

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Research & integrations
TAVILY_API_KEY=
NOTION_API_KEY=
GOOGLE_DRIVE_ACCESS_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# App
DEBUG=false
